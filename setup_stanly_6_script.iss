[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{CB2A586C-C37C-4FDD-B955-DCABD505B4DC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName=C:\Program Files\MATLAB\{#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=C:\Program Files\MATLAB\Stanly FEA 2017\documentation\License.txt
InfoBeforeFile=C:\Program Files\MATLAB\Stanly FEA 2017\documentation\Warning.txt
OutputDir=C:\Program Files\MATLAB\Stanly FEA 2017
OutputBaseFilename=setup_stanly_6
SetupIconFile=C:\Program Files\MATLAB\Stanly FEA 2017\program\media\setup.ico
Password=quiscustodietipsoscustodes?
Compression=lzma
SolidCompression=yes
UninstallDisplayIcon=C:\Program Files\MATLAB\Stanly FEA 2017\program\media\setdw.ico
UninstallDisplayName={#MyAppName}
BackColor=$000000
WizardSmallImageFile=C:\Program Files\MATLAB\Stanly FEA 2017\design\bmp\icon_io.bmp
WizardImageFile=C:\Program Files\MATLAB\Stanly FEA 2017\design\bmp\pattern.bmp
UninstallFilesDir={app}\uninst

[Registry]
